# Copy to local.env (ignored). Environment variables already set win.
# Relative paths resolve from this file's directory.
# Set either the generic pair or the target-specific pairs below.

# AROS_TARGET=one
# AROS_GCC_ROOT=
# AROS_SDK=

# AROS_MAINLINE_GCC_ROOT=
# AROS_MAINLINE_SDK=
# AROS_ONE_GCC_ROOT=
# AROS_ONE_SDK=

# Optional legacy shared-directory and linker-volume settings.
# AROS_MAINLINE_SHARED=
# AROS_ONE_SHARED=
# AROS_BUILD_VOLUME=

# Raspberry Pi (aros-aarch64-abiv1-raspi): Clang toolchain bin directory, the
# matching Developer SDK and a libc++ built for the target.
# AROS_RASPI_GCC_ROOT=
# AROS_RASPI_SDK=
# AROS_RASPI_CXXRT=
