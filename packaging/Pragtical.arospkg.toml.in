id              = "pragtical"
version         = "@VERSION@"
revision        = @REVISION@
summary         = "Lightweight code editor: syntax highlighting, project tree, find in files"
category        = "development/edit"
license         = "MIT"
kind            = "app"
arch            = "@ARCH@"
abi             = "@ABI@"
subdir          = "Pragtical"
icon            = "Pragtical.info"
depends         = []
depends_checked = true
post_install_notes = [
  "Start it from the pragtical icon, which sets the stack the editor needs.",
  "From a Shell: Execute run-pragtical, or Stack 8000000 and then pragtical <file or drawer>.",
  "Settings and added plugins are kept in the user drawer of the package.",
]
