+/* A minimised window is closed. An icon on the Workbench stands for it, and a
+ * double click on that icon opens the window again. */
 void
 AROS_MinimizeWindow(SDL_VideoDevice *_this, SDL_Window * window)
 {
 	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	SDL_VideoData *vd = data->videodata;
 
 	D(bug("[SDL3:aroswindow] %s: wnd 0x%08lx\n", __func__, data->win));
 
+	if (data->win == NULL || (data->sdlflags & SDL_WINDOW_MINIMIZED))
+		return;
+
+	/* Without the icon nothing could bring the window back, so it stays. */
+	if (vd->AppIconRef == NULL) {
+		if (vd->AppIcon == NULL)
+			return;
+		vd->AppIconRef = AddAppIconA(0, 0, FilePart(vd->FullAppName), &vd->WBPort, 0, vd->AppIcon, NULL);
+		if (vd->AppIconRef == NULL)
+			return;
+	}
+
 	data->sdlflags |=  SDL_WINDOW_MINIMIZED;
 	data->sdlflags &= ~SDL_WINDOW_MAXIMIZED;
 
 	AROS_HideWindow(_this, window);
+	SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_MINIMIZED, 0, 0);
 }
 
 void
 AROS_RestoreWindow(SDL_VideoDevice *_this, SDL_Window * window)
 {
 	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	SDL_VideoData *vd = data->videodata;
 
 	D(bug("[SDL3:aroswindow] %s: wnd 0x%08lx\n", __func__, data->win));
 
-	if (data->win) {
-		data->sdlflags &= ~(SDL_WINDOW_MINIMIZED | SDL_WINDOW_MAXIMIZED);
+	if (data->sdlflags & SDL_WINDOW_MINIMIZED) {
+		SDL_WindowData *wd;
+		bool others = false;
 
-		ChangeWindowBox(data->win, window->x, window->y, window->w, window->h);
+		data->sdlflags &= ~SDL_WINDOW_MINIMIZED;
+		ForeachNode(&vd->windowlist, wd)
+		{
+			if (wd->sdlflags & SDL_WINDOW_MINIMIZED)
+				others = true;
+		}
+		if (!others && vd->AppIconRef) {
+			RemoveAppIcon(vd->AppIconRef);
+			vd->AppIconRef = NULL;
+		}
+
+		AROS_ShowWindow_Internal(_this, window);
+		if (data->win) {
+			SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESTORED, 0, 0);
+			SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_EXPOSED, 0, 0);
+		}
+		return;
+	}
+
+	if (data->win && (data->winflags & SDL_AROS_WINDOW_FULLSCREEN) == 0) {
+		data->sdlflags &= ~SDL_WINDOW_MAXIMIZED;
+
+		/* window->w and window->h describe the area inside the borders. */
+		ChangeWindowBox(data->win, window->x, window->y,
+			window->w + data->win->BorderLeft + data->win->BorderRight,
+			window->h + data->win->BorderTop + data->win->BorderBottom);
 		AROS_WindowToFront(data->win);
 	}
 }
