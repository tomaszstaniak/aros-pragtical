-// Convert UTF-8 to ISO-8859-1
+/* The system character set.
+ *
+ * AROS has no call that names it. Locale preferences store a
+ * codesets.library name in the CHARSET variable, and keymaps and classic
+ * text clipboards use that set: with pc105_pl the key for "a ogonek" gives
+ * 0xB1, which is ISO 8859-2. codesets.library supplies the table from byte
+ * to Unicode. Without the library or the variable the set is taken to be
+ * ISO 8859-1, where byte and code point are equal.
+ */
+static Uint32 aros_charset[256];
+static bool aros_charset_ready = false;
+
+static void AROS_InitCharset(void)
+{
+    struct Library *CodesetsBase; /* local: hides the global the proto header declares */
+    int i;
+
+    if (aros_charset_ready)
+        return;
+    for (i = 0; i < 256; i++)
+        aros_charset[i] = (Uint32)i;
+
+    CodesetsBase = OpenLibrary((CONST_STRPTR)"codesets.library", 6);
+    if (CodesetsBase) {
+        struct TagItem strict[] = { { CSA_FallbackToDefault, FALSE }, { TAG_DONE, 0 } };
+        struct TagItem fallback[] = { { CSA_FallbackToDefault, TRUE }, { TAG_DONE, 0 } };
+        struct codeset *set = NULL;
+        char name[64];
+
+        if (GetVar((CONST_STRPTR)"CHARSET", (STRPTR)name, sizeof(name), 0) > 0)
+            set = CodesetsFindA((STRPTR)name, strict);
+        if (!set)
+            set = CodesetsFindA(NULL, fallback);
+        if (set) {
+            for (i = 0x80; i < 256; i++) {
+                if (set->table[i].ucs4 >= 0x80)
+                    aros_charset[i] = set->table[i].ucs4;
+            }
+        }
+        CloseLibrary(CodesetsBase);
+    }
+    aros_charset_ready = true;
+}
+
+// One byte of the system character set as a Unicode code point
+Uint32 AROS_SystemCharToUCS4(unsigned char c)
+{
+    AROS_InitCharset();
+    return aros_charset[c];
+}
