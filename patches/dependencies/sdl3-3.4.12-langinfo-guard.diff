# SDL3 3.4.12: only include langinfo.h when HAVE_NL_LANGINFO.
# ABIv11 posixc has no langinfo.h. Carried from aros-openloco.
# Worth sending to contrib.
#
--- a/src/time/unix/SDL_systime.c
+++ b/src/time/unix/SDL_systime.c
@@ -23,7 +23,9 @@
 #include "../SDL_time_c.h"
 #include <errno.h>
+#ifdef HAVE_NL_LANGINFO
 #include <langinfo.h>
+#endif
 #include <sys/time.h>
 #include <time.h>
 #include <unistd.h>
