+#ifdef __AROS__
+/* posixc hides realpath unless _POSIX_C_SOURCE >= 200112L; gnu11 does
+ * not set that, and the 64-bit implicit-int return would truncate. */
+#include <limits.h>
+#ifndef PATH_MAX
+#define PATH_MAX 1024
+#endif
+char *realpath(const char *, char *);
+#endif
 #endif
 
 #define dialogfinished_event_name "dialogfinished"
@@ -747,6 +756,16 @@ static int f_chdir(lua_State *L) {
   if (wpath == NULL) { return luaL_error(L, UTFCONV_ERROR_INVALID_CONVERSION ); }
   int err = _wchdir(wpath);
   SDL_free(wpath);
+#elif defined(__AROS__)
+  /* posixc chdir rejects a trailing slash that is not a volume root. */
+  char tmp[PATH_MAX];
+  size_t n = strlen(path);
+  if (n >= sizeof tmp)
+    return luaL_error(L, "chdir() failed: path too long");
+  memcpy(tmp, path, n + 1);
+  if (n > 1 && tmp[n - 1] == '/' && tmp[n - 2] != ':')
+    tmp[n - 1] = '\0';
+  int err = chdir(tmp);
 #else
   int err = chdir(path);
 #endif
@@ -791,16 +810,6 @@ static int f_list_dir(lua_State *L) {
