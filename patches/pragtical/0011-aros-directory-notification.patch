diff --git a/src/api/dirmonitor/aros.c b/src/api/dirmonitor/aros.c
new file mode 100644
index 00000000..0ac78657
--- /dev/null
+++ b/src/api/dirmonitor/aros.c
@@ -0,0 +1,281 @@
+/*
+ * Directory monitor for AROS, built on dos.library file notification.
+ *
+ * Every watched path gets its own NotifyRequest that sends messages to one
+ * port. All dos.library calls are made by the main thread (init, add, remove,
+ * deinit). The monitor thread only takes messages off the port, so it never
+ * needs to be a DOS process. The port ignores message arrival (PA_IGNORE) and
+ * is polled, which keeps the main task's signals untouched and lets deinit
+ * finish without having to wake a waiting thread.
+ *
+ * Only file systems known to report changes inside a watched directory are
+ * used: the RAM disk and SFS. FAT accepts a request for a directory but stays
+ * silent when files in it are created, renamed or deleted (measured on the
+ * x86_64 nightly of 2026-11-13), so a request there would hide every change.
+ * For any other file system add returns -1 and the caller falls back to
+ * comparing modification times.
+ */
+#include <SDL3/SDL.h>
+
+#include <string.h>
+
+#include <exec/types.h>
+#include <exec/lists.h>
+#include <exec/memory.h>
+#include <exec/ports.h>
+#include <exec/semaphores.h>
+#include <dos/dos.h>
+#include <dos/dosextens.h>
+#include <dos/notify.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+
+#include "dirmonitor.h"
+
+#define POLL_INTERVAL_MS 100
+
+struct aros_watch {
+  struct NotifyRequest request;
+  int changed;
+  char name[1];
+};
+
+struct dirmonitor_internal {
+  struct SignalSemaphore lock;
+  struct MsgPort* port;
+  struct aros_watch** watches;
+  int capacity;
+  int closed;
+};
+
+
+/* Takes every queued notification off the port and marks its watch. Call with
+ * the lock held. Messages are replied at once: the file system owns them. */
+static void drain_port(struct dirmonitor_internal* monitor) {
+  struct Message* message;
+
+  while ((message = GetMsg(monitor->port)) != NULL) {
+    struct NotifyMessage* notify = (struct NotifyMessage*) message;
+
+    if (notify->nm_Class == NOTIFY_CLASS && notify->nm_NReq) {
+      int id = (int) notify->nm_NReq->nr_UserData;
+
+      if (id >= 0 && id < monitor->capacity && monitor->watches[id]
+          && &monitor->watches[id]->request == notify->nm_NReq)
+        monitor->watches[id]->changed = 1;
+    }
+    ReplyMsg(message);
+  }
+}
+
+
+/* True when the path lives on a file system whose notifications cover the
+ * entries of a watched directory. */
+static int notifies_directory_changes(const char* path) {
+  struct DevProc* target;
+  struct DevProc* ram;
+  struct InfoData info __attribute__((aligned(8)));
+  BPTR lock;
+  int result = 0;
+
+  target = GetDeviceProc((STRPTR) path, NULL);
+  if (!target)
+    return 0;
+  ram = GetDeviceProc((STRPTR) "RAM:", NULL);
+  if (ram) {
+    result = ram->dvp_Port != NULL && ram->dvp_Port == target->dvp_Port;
+    FreeDeviceProc(ram);
+  }
+  FreeDeviceProc(target);
+  if (result)
+    return 1;
+
+  lock = Lock((STRPTR) path, SHARED_LOCK);
+  if (!lock)
+    return 0;
+  memset(&info, 0, sizeof(info));
+  if (Info(lock, &info))
+    result = (info.id_DiskType & 0xFFFFFF00UL) == AROS_MAKE_ID('S', 'F', 'S', 0);
+  UnLock(lock);
+  return result;
+}
+
+
+static struct dirmonitor_internal* init_dirmonitor(void) {
+  struct dirmonitor_internal* monitor = SDL_calloc(1, sizeof(struct dirmonitor_internal));
+
+  if (!monitor)
+    return NULL;
+  InitSemaphore(&monitor->lock);
+  monitor->port = CreateMsgPort();
+  if (monitor->port)
+    monitor->port->mp_Flags = PA_IGNORE;
+  return monitor;
+}
+
+
+static void deinit_dirmonitor(struct dirmonitor_internal* monitor) {
+  int id;
+
+  if (!monitor)
+    return;
+  ObtainSemaphore(&monitor->lock);
+  monitor->closed = 1;
+  if (monitor->port) {
+    for (id = 0; id < monitor->capacity; id++)
+      if (monitor->watches[id])
+        EndNotify(&monitor->watches[id]->request);
+    drain_port(monitor);
+    for (id = 0; id < monitor->capacity; id++)
+      if (monitor->watches[id])
+        FreeVec(monitor->watches[id]);
+    /* The signal bit belongs to the task that created the port; restore the
+     * flag so that DeleteMsgPort releases it. */
+    monitor->port->mp_Flags = PA_SIGNAL;
+    DeleteMsgPort(monitor->port);
+    monitor->port = NULL;
+  }
+  SDL_free(monitor->watches);
+  monitor->watches = NULL;
+  monitor->capacity = 0;
+  ReleaseSemaphore(&monitor->lock);
+}
+
+
+static int get_changes_dirmonitor(struct dirmonitor_internal* monitor, char* buffer, int buffer_size) {
+  int* ids = (int*) buffer;
+  int limit = buffer_size / (int) sizeof(int);
+  int count = 0;
+  int id;
+
+  if (!monitor)
+    return -1;
+  ObtainSemaphore(&monitor->lock);
+  if (monitor->closed || !monitor->port) {
+    ReleaseSemaphore(&monitor->lock);
+    return -1;
+  }
+  drain_port(monitor);
+  for (id = 0; id < monitor->capacity && count < limit; id++) {
+    if (monitor->watches[id] && monitor->watches[id]->changed) {
+      monitor->watches[id]->changed = 0;
+      ids[count++] = id;
+    }
+  }
+  ReleaseSemaphore(&monitor->lock);
+
+  if (count == 0) {
+    SDL_Delay(POLL_INTERVAL_MS);
+    return 0;
+  }
+  return count * (int) sizeof(int);
+}
+
+
+static int translate_changes_dirmonitor(struct dirmonitor_internal* monitor, char* buffer, int buffer_size, int (*change_callback)(int, const char*, void*), void* data) {
+  int* ids = (int*) buffer;
+  int count = buffer_size / (int) sizeof(int);
+  int i;
+
+  for (i = 0; i < count; i++)
+    change_callback(ids[i], NULL, data);
+  return 0;
+}
+
+
+static int add_dirmonitor(struct dirmonitor_internal* monitor, const char* path) {
+  struct aros_watch* watch;
+  size_t length;
+  int id;
+
+  if (!monitor || !path || !*path)
+    return -1;
+
+  length = strlen(path);
+  /* "Work:src/" names the same directory as "Work:src". */
+  while (length > 1 && path[length - 1] == '/' && path[length - 2] != ':' && path[length - 2] != '/')
+    length--;
+
+  watch = AllocVec(sizeof(struct aros_watch) + length, MEMF_PUBLIC | MEMF_CLEAR);
+  if (!watch)
+    return -1;
+  memcpy(watch->name, path, length);
+  watch->name[length] = '\0';
+  if (!notifies_directory_changes(watch->name)) {
+    FreeVec(watch);
+    return -1;
+  }
+
+  ObtainSemaphore(&monitor->lock);
+  if (monitor->closed || !monitor->port) {
+    ReleaseSemaphore(&monitor->lock);
+    FreeVec(watch);
+    return -1;
+  }
+
+  for (id = 0; id < monitor->capacity; id++)
+    if (!monitor->watches[id])
+      break;
+  if (id == monitor->capacity) {
+    int capacity = monitor->capacity ? monitor->capacity * 2 : 32;
+    struct aros_watch** watches = SDL_realloc(monitor->watches, capacity * sizeof(*watches));
+
+    if (!watches) {
+      ReleaseSemaphore(&monitor->lock);
+      FreeVec(watch);
+      return -1;
+    }
+    memset(watches + monitor->capacity, 0, (capacity - monitor->capacity) * sizeof(*watches));
+    monitor->watches = watches;
+    monitor->capacity = capacity;
+  }
+
+  watch->request.nr_Name = (STRPTR) watch->name;
+  watch->request.nr_UserData = (IPTR) id;
+  watch->request.nr_Flags = NRF_SEND_MESSAGE;
+  watch->request.nr_stuff.nr_Msg.nr_Port = monitor->port;
+
+  /* The slot is filled before the request is posted, so a notification that
+   * arrives at once is matched to this watch. */
+  monitor->watches[id] = watch;
+  if (!StartNotify(&watch->request)) {
+    monitor->watches[id] = NULL;
+    ReleaseSemaphore(&monitor->lock);
+    FreeVec(watch);
+    return -1;
+  }
+  ReleaseSemaphore(&monitor->lock);
+  return id;
+}
+
+
+static void remove_dirmonitor(struct dirmonitor_internal* monitor, int id) {
+  struct aros_watch* watch;
+
+  if (!monitor || id < 0)
+    return;
+  ObtainSemaphore(&monitor->lock);
+  if (!monitor->closed && monitor->port && id < monitor->capacity && monitor->watches[id]) {
+    watch = monitor->watches[id];
+    EndNotify(&watch->request);
+    /* Messages posted before EndNotify still point at this request. */
+    drain_port(monitor);
+    monitor->watches[id] = NULL;
+    FreeVec(watch);
+  }
+  ReleaseSemaphore(&monitor->lock);
+}
+
+
+static int get_mode_dirmonitor(void) { return 2; }
+
+struct dirmonitor_backend dirmonitor_aros = {
+  .name = "aros",
+  .init = init_dirmonitor,
+  .deinit = deinit_dirmonitor,
+  .get_changes = get_changes_dirmonitor,
+  .translate_changes = translate_changes_dirmonitor,
+  .add = add_dirmonitor,
+  .remove = remove_dirmonitor,
+  .get_mode = get_mode_dirmonitor,
+};
