Title: 0008-lua54-language-test-env
Repository: pragtical
Base-Commit: 5c05f09e081833b581fb5ecd10e64963dec87f03
Requires: 0007-file-argument-project-directory.patch
Author: aros-pragtical project
Date: 2026-11-15
Upstream-Status: local-only
Scope: Lua language regression harness only; no production tokenizer behavior changes

Problem:
  The language regression harness uses setfenv, which was removed in Lua 5.4, so the Lua tokenizer implementation cannot load.
Solution:
  Pass the isolated environment directly to loadfile in text mode, which works with Lua 5.2+ and preserves the native/Lua token comparison.
Validation:
  x86_64 ABIv1 Lua 5.4 language fixture suite: 2 tests passed, including 126 native/Lua tokenizer samples.
Removal:
  Permanent Lua 5.4 compatibility fix for the regression harness.

diff --git a/scripts/lua/tests/languages/init.lua b/scripts/lua/tests/languages/init.lua
index 7ae41180..e4027d92 100644
--- a/scripts/lua/tests/languages/init.lua
+++ b/scripts/lua/tests/languages/init.lua
@@ -42,7 +42,6 @@ local function deep_copy(value, seen)
 end
 
 local function load_lua_tokenizer()
-  local chunk = assert(loadfile(source_file("data/core/tokenizer.lua")))
   local env = setmetatable({}, { __index = _G })
   env.require = function(name)
     if name == "tokenizer" then
@@ -55,7 +54,7 @@ local function load_lua_tokenizer()
     end
     return require(name)
   end
-  setfenv(chunk, env)
+  local chunk = assert(loadfile(source_file("data/core/tokenizer.lua"), "t", env))
   return chunk()
 end
 
