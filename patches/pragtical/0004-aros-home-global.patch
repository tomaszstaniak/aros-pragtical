Title: 0004-aros-home-global
Repository: pragtical
Base-Commit: 5c05f09e081833b581fb5ecd10e64963dec87f03
Requires: 0003-aros-absolute-paths.patch
Author: aros-pragtical project
Date: 2026-09-20
Upstream-Status: candidate
Scope: start.lua HOME fallback and common.home_encode/home_expand.

Problem:
  AROS has no HOME; main.c assigns os.getenv nil which deletes the global, then core.strict makes any read of HOME a fatal error when New File pretty-prints the path.
Solution:
  If HOME is missing or empty after EXEDIR is known, set it to EXEDIR so ~ and home_encode have a string. home_encode/home_expand use rawget so a missing HOME cannot abort the editor.
Validation:
  The Pragtical 3.14.0 x86_64 ABIv1 build compiled and linked on 2026-11-15. New-document creation, Save As, overwrite and collected-byte checks passed.
Removal:
  Remove when the pinned upstream provides equivalent missing-HOME behavior and the AROS new-file and save checks pass.

diff --git a/data/core/common.lua b/data/core/common.lua
index 555aef70..07ce9cca 100644
--- a/data/core/common.lua
+++ b/data/core/common.lua
@@ -663,8 +663,9 @@ end
 ---@param text string
 ---@return string
 function common.home_encode(text)
-  if HOME and string.find(text, HOME, 1, true) == 1 then
-    local dir_pos = #HOME + 1
+  local home = rawget(_G, "HOME")
+  if home and string.find(text, home, 1, true) == 1 then
+    local dir_pos = #home + 1
     -- ensure we don't replace if the text is just "$HOME" or "$HOME/" so
     -- it must have a "/" following the $HOME and some characters following.
     if string.find(text, PATHSEP, dir_pos, true) == dir_pos and #text > dir_pos then
@@ -692,7 +693,8 @@ end
 ---@param text string
 ---@return string
 function common.home_expand(text)
-  return HOME and text:gsub("^~", HOME) or text
+  local home = rawget(_G, "HOME")
+  return home and text:gsub("^~", home) or text
 end
 
 
diff --git a/data/core/start.lua b/data/core/start.lua
index aa04fec7..615ae473 100644
--- a/data/core/start.lua
+++ b/data/core/start.lua
@@ -12,6 +12,12 @@ SCALE = 1.0
 PATHSEP = package.config:sub(1, 1)
 
 EXEDIR = EXEFILE:match("^(.+)[/\\][^/\\]+$")
+-- AROS has no HOME. Assigning os.getenv("HOME") nil in main.c deletes the
+-- global; after core.strict is installed, reading it is a fatal error.
+-- Empty string is also unusable: it is truthy and matches every path prefix.
+if type(HOME) ~= "string" or HOME == "" then
+  HOME = EXEDIR
+end
 if MACOS_RESOURCES then
   DATADIR = MACOS_RESOURCES
 else
@@ -21,7 +27,7 @@ end
 USERDIR = (system.get_file_info(EXEDIR .. PATHSEP .. 'user') and (EXEDIR .. PATHSEP .. 'user'))
        or os.getenv("PRAGTICAL_USERDIR")
        or ((os.getenv("XDG_CONFIG_HOME") and os.getenv("XDG_CONFIG_HOME") .. PATHSEP .. "pragtical"))
-       or (HOME and (HOME .. PATHSEP .. '.config' .. PATHSEP .. 'pragtical'))
+       or (HOME .. PATHSEP .. '.config' .. PATHSEP .. 'pragtical')
 
 -- Backend selection happens when the first font or window is created. A soft
 -- restart retains those native resources, so only apply this on process startup.
